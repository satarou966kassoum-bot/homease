PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/homease

# JWT
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=30d

# CORS / client
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Compte administrateur créé par "npm run seed"
ADMIN_NAME=Kassoum
ADMIN_EMAIL=admin@homease.bj
ADMIN_PASSWORD=change-moi-mot-de-passe-fort

# Réservé pour une future intégration (non utilisé en Phase 1)
MOBILE_MONEY_PROVIDER=
MOBILE_MONEY_API_KEY=

# Taux de commission de la plateforme sur chaque paiement (0.05 = 5%)
COMMISSION_RATE=0.05

# Cloudinary (upload gratuit d'images et vidéos — https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
